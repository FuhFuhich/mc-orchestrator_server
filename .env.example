# ═════════════════════════════════════════════════════════════════════════════
# mc-orchestrator deployment secrets.
#
# Copy to `.env` before running `docker compose up`:
#     cp .env.example .env
#     nano .env
#
# All variables marked REQUIRED must be set or the stack will refuse to start.
# ═════════════════════════════════════════════════════════════════════════════

# ─── Public domain ──────────────────────────────────────────────────────────
PUBLIC_DOMAIN=mc-orchestrator.xyz
CERTBOT_EMAIL=admin@mc-orchestrator.xyz

# ─── Database (REQUIRED) ────────────────────────────────────────────────────
DB_NAME=mc_orchestrator
DB_USER=postgres
DB_PASSWORD=CHANGE-ME-to-a-long-random-string

# Use 'update' during first boot so Hibernate auto-creates tables,
# then switch to 'validate' or 'none' in production.
JPA_DDL_AUTO=update

# ─── Backend secrets (REQUIRED) ─────────────────────────────────────────────
# JWT secret — any long random string (≥ 32 bytes).
# Tip: openssl rand -base64 48
APP_JWT_SECRET=CHANGE-ME-to-at-least-32-characters-of-random-data
APP_JWT_EXPIRATION_MS=86400000
APP_REFRESH_TOKEN_DAYS=30

# Encryption key for SSH/RCON credentials — MUST be exactly 32 characters.
# DO NOT rotate this value after the app has been used; stored credentials
# would become undecryptable.
# Tip: openssl rand -base64 24 | cut -c1-32
APP_ENCRYPTION_KEY=CHANGE-ME-exact-32-character-value!

# ─── CORS ───────────────────────────────────────────────────────────────────
# Comma-separated list of origins allowed by the browser to talk to /api/.
APP_CORS_ALLOWED_ORIGINS=https://mc-orchestrator.xyz,https://www.mc-orchestrator.xyz,http://localhost:5500

# ─── Remote node filesystem (managed MC nodes) ──────────────────────────────
# Root dir on every managed node that the SSH user can write to.
APP_REMOTE_ROOT=/opt/mc-com
APP_REMOTE_DOCKER_RAM_PATH=/dev/shm/mc-com/servers

# ─── VM-mode bundles (optional) ─────────────────────────────────────────────
# Leave empty unless you bind-mount src/main/resources/server-dist into the
# backend container. Example:  APP_SERVER_DIST_ROOT=/app/server-dist
APP_SERVER_DIST_ROOT=

# ─── Logging / tuning ───────────────────────────────────────────────────────
APP_LOG_LEVEL=INFO

# ─── Frontend static files ──────────────────────────────────────────────────
# Host path to the web app root (served read-only by mc-web / mc-proxy).
# Default assumes the web repo sits next to this one as
#   ../mine_com_web/mc-orchestrator_web
WEB_ROOT=../mine_com_web/mc-orchestrator_web

# ─── Nginx proxy config switcher ────────────────────────────────────────────
# On first boot leave this unset (bootstrap HTTP-only config is used).
# After `docker compose run --rm certbot` has issued a real cert, set:
#   PROXY_CONF=./nginx/proxy.conf
# and run: docker compose up -d proxy
PROXY_CONF=./nginx/proxy-bootstrap.conf
